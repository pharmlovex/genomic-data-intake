// All tools live in one image (pipeline/Dockerfile), pushed to OCIR.
params.container = 'uk-london-1.ocir.io/NAMESPACE/genome-intake/pipeline-tools:0.1.0'

process {
    container     = params.container
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' } // OOM-killed or node preempted
    maxRetries    = 2
    memory        = { 2.GB * task.attempt }
}

// OCI Object Storage through its Amazon S3 Compatibility API.
// Credentials: an OCI "Customer Secret Key", exported as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
def ociRegion    = System.getenv('OCI_REGION') ?: 'uk-london-1'
def ociNamespace = System.getenv('OCI_NAMESPACE') ?: 'NAMESPACE'

aws {
    region = ociRegion
    client {
        endpoint          = "https://${ociNamespace}.compat.objectstorage.${ociRegion}.oraclecloud.com"
        s3PathStyleAccess = true
    }
}

profiles {
    // Laptop: Docker, with the small test data from scripts/make_test_data.py.
    local {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
    }

    // OKE: one pod per task; the work directory is a shared persistent volume.
    oke {
        process.executor = 'k8s'
        workDir          = '/workspace/work'
        k8s {
            namespace        = 'genomics'
            serviceAccount   = 'nextflow'
            storageClaimName = 'nextflow-work'
            storageMountPath = '/workspace'
        }
    }
}

trace.enabled      = true
trace.overwrite    = true
report.enabled     = true
report.overwrite   = true
timeline.enabled   = true
timeline.overwrite = true
